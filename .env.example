# FLASK_ENV=development autorise des valeurs de secours pour les secrets
# (SECRET_KEY, ADMIN_MOT_DE_PASSE, MYSQL_MOT_DE_PASSE) en local uniquement.
# Ne JAMAIS définir cette variable en production : sans elle, l'application
# refuse de démarrer si un secret requis est absent (comportement voulu).
FLASK_ENV=development

SECRET_KEY=change-moi-en-une-longue-chaine-aleatoire
ADMIN_UTILISATEUR=admin
ADMIN_MOT_DE_PASSE=change-ce-mot-de-passe
MYSQL_MOT_DE_PASSE=change-ce-mot-de-passe-aussi
FLASK_DEBUG=0
PORT=5000
